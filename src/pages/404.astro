---
import BaseLayout from "#/layouts/BaseLayout.astro";
import { useTranslate } from "#/i18n";

const en = useTranslate("en");
const zh = useTranslate("zh-cn");
---

<BaseLayout lang="en" title={`${en("not_found")} / ${zh("not_found")}`}>
  <header class="hero" style="text-align:center">
    <p class="eyebrow">404</p>
    <h1>{en("not_found")}</h1>
    <p>{zh("not_found")}</p>
    <div class="center not-found-actions">
      <a class="btn" href="/en/">{en("back_home")}</a>
      <a class="btn" href="/zh-cn/">{zh("back_home")}</a>
    </div>
  </header>
</BaseLayout>
