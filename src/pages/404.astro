---
import BaseLayout from "#/layouts/BaseLayout.astro";
import { t } from "#/i18n";

const lang = "en";
---

<BaseLayout lang={lang} title={t(lang, "not_found")}>
  <header class="hero" style="text-align:center">
    <p class="eyebrow">404</p>
    <h1>{t(lang, "not_found")}</h1>
    <div class="center" style="margin-top:1.5rem">
      <a class="btn" href={`/${lang}/`}>{t(lang, "back_home")}</a>
    </div>
  </header>
</BaseLayout>
