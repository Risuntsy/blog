---
import { getCollection, render } from "astro:content";
import { LANGS, useTranslate, fmtDate, l } from "#/i18n";
import BaseLayout from "#/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("post", ({ data }) => !data.draft);
  const slugs = [
    ...new Set(posts.map((p) => p.id.replace(/^(en|zh-cn)\//, ""))),
  ];
  return LANGS.flatMap((lang) =>
    slugs.map((slug) => ({ params: { lang, slug } })),
  );
}

const lang = Astro.params.lang as string;
const t = useTranslate(lang);
const slug = Astro.params.slug as string;

const allPosts = await getCollection("post");
const post = allPosts.find((p) => !p.data.draft && p.id === `${lang}/${slug}`);

if (!post) {
  return Astro.redirect(`/${lang}`);
}

const { Content } = await render(post);
const dateStr = fmtDate(lang, post.data.created_at);
const updatedStr = post.data.updated_at
  ? fmtDate(lang, post.data.updated_at)
  : undefined;
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  current="posts"
>
  <article class="article" data-pagefind-body>
    <p class="meta">
      <span>{t("posted_at", { date: dateStr })}</span>
      {
        updatedStr && updatedStr !== dateStr && (
          <span>{t("updated_at", { date: updatedStr })}</span>
        )
      }
    </p>
    <h1 data-pagefind-meta="title">{post.data.title}</h1>
    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={l(lang, `/tag/${tag}`)}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
