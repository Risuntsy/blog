---
import type { CollectionEntry } from "astro:content";
import { useTranslate, fmtDate, tagHref } from "#/i18n";
import { postSlug, postLang } from "#/utils";

interface Props {
    post: CollectionEntry<"post">;
    currentTag?: string;
}

const { post, currentTag } = Astro.props;
const lang = postLang(post);
const t = useTranslate(lang);
const slug = postSlug(post);
const dateStr = fmtDate(lang, post.data.created_at);
const href = `/${lang}/post/${slug}`;

const bodyText = post.body
    ?.replace(/^(```|~~~)[\s\S]*?^\1/gm, "")
    ?.replace(/^#+ .*/gm, "")
    ?.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    ?.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    ?.replace(/<[^>]+>/g, "")
    ?.replace(/[`*_~>#|]/g, "")
    ?.replace(/\s+/g, " ")
    ?.trim();
const excerptLength = lang === "zh-cn" ? 110 : 200;
const excerpt =
    bodyText && bodyText.length > excerptLength ? `${bodyText.slice(0, excerptLength).trimEnd()}…` : bodyText;
const preview = post.data.description || excerpt || "";
---

<article class="card">
    <p class="meta">
        <time datetime={post.data.created_at.toISOString().slice(0, 10)}>{dateStr}</time>
        {post.data.pinned && <span class="pinned">{t("pinned")}</span>}
    </p>
    <h2 class="card-title">
        <a href={href}>{post.data.title}</a>
    </h2>
    {preview && <p class="card-excerpt">{preview}</p>}
    {
        post.data.tags.length > 0 && (
            <p class="tags">
                {post.data.tags.map(tag =>
                    tag === currentTag ? (
                        <span class="tag" aria-current="page">
                            #{tag}
                        </span>
                    ) : (
                        <a class="tag" href={tagHref(lang, tag)}>
                            #{tag}
                        </a>
                    ),
                )}
            </p>
        )
    }
</article>
