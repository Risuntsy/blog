---
import type { CollectionEntry } from "astro:content";
import { useTranslate, fmtDate, tagHref } from "#/i18n";
import { postSlug, postLang } from "#/utils";

interface Props {
    post: CollectionEntry<"post">;
    currentTag?: string;
}

const { post, currentTag } = Astro.props;
const lang = postLang(post);
const t = useTranslate(lang);
const slug = postSlug(post);
const dateStr = fmtDate(lang, post.data.created_at);
const href = `/${lang}/post/${slug}`;

const bodyText = post.body
    ?.replace(/^#+ .*/gm, "")
    ?.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    ?.replace(/[`*_~>#]/g, "")
    ?.replace(/\n{2,}/g, " ")
    ?.trim()
    ?.slice(0, 200);
const preview = post.data.description || (bodyText ? `${bodyText}…` : "");
---

<article class="card">
    <h2 class="card-title">
        <a href={href}>{post.data.title}</a>
    </h2>
    <p class="meta">{dateStr}</p>
    {preview && <p class="card-excerpt">{preview}</p>}
    {
        (post.data.pinned || post.data.tags.length > 0) && (
            <div class="tags">
                {post.data.pinned && <span class="tag pinned">{t("pinned")}</span>}
                {post.data.tags.map(tag =>
                    tag === currentTag ? (
                        <span class="tag" aria-current="page">
                            #{tag}
                        </span>
                    ) : (
                        <a class="tag" href={tagHref(lang, tag)}>
                            #{tag}
                        </a>
                    ),
                )}
            </div>
        )
    }
    <p class="card-more">
        <a href={href}>{t("read_more")} →</a>
    </p>
</article>
