---
import { useTranslate, l, LANGS, languagePath } from "#/i18n";
import Search from "#/components/Search.astro";
import FeedPicker from "#/components/FeedPicker.astro";

interface Props {
    lang: string;
    current?: string;
    languagePaths?: Record<string, string>;
}

const { lang, current = "", languagePaths: languagePathOverrides } = Astro.props;
const t = useTranslate(lang);
const languagePaths =
    languagePathOverrides ?? Object.fromEntries(LANGS.map(code => [code, languagePath(Astro.url.pathname, code)]));
const otherLang = LANGS.find(code => code !== lang && languagePaths[code]);
const here = Astro.url.pathname.replace(/\/$/, "");
const homePath = l(lang, "");

const links = [
    { key: "posts", href: "", label: t("nav_posts") },
    { key: "tags", href: "/tag", label: t("nav_tags") },
    { key: "archive", href: "/archive", label: t("nav_archive") },
    { key: "about", href: "/about", label: t("nav_about") },
];
---

<blog-header
    data-theme-labels={JSON.stringify({ auto: t("theme_auto"), light: t("theme_light"), dark: t("theme_dark") })}
>
    <header class="site-header">
        {
            here === homePath ? (
                <span class="site-title">{t("site_title")}</span>
            ) : (
                <a class="site-title" href={homePath}>
                    {t("site_title")}
                </a>
            )
        }
        <nav class="nav" aria-label={t("nav_main")}>
            {
                links.map(item =>
                    here === l(lang, item.href) ? (
                        <span class="nav-link" aria-current="page">
                            {item.label}
                        </span>
                    ) : (
                        <a
                            class="nav-link"
                            href={l(lang, item.href)}
                            aria-current={current === item.key ? "true" : undefined}
                        >
                            {item.label}
                        </a>
                    ),
                )
            }
        </nav>
        <div class="nav-tools">
            {
                otherLang && (
                    <a
                        class="nav-link"
                        href={languagePaths[otherLang]}
                        hreflang={otherLang}
                        lang={otherLang}
                        title={t("nav_language")}
                    >
                        {otherLang === "zh-cn" ? "中文" : "EN"}
                    </a>
                )
            }
            <button class="nav-link" type="button" data-theme-toggle title={t("nav_theme")}>
                {t("theme_auto")}
            </button>
            <Search lang={lang} />
            <FeedPicker lang={lang} />
        </div>
    </header>
</blog-header>

<script>
    const MODES = ["auto", "light", "dark"] as const;
    type Mode = (typeof MODES)[number];

    class BlogHeader extends HTMLElement {
        private readonly colorScheme = matchMedia("(prefers-color-scheme: dark)");
        private readonly toggle = this.querySelector<HTMLButtonElement>("[data-theme-toggle]");
        private readonly labels: Record<Mode, string> = JSON.parse(this.dataset.themeLabels ?? "{}");

        private get mode(): Mode {
            const stored = localStorage.getItem("theme-mode");
            return MODES.includes(stored as Mode) ? (stored as Mode) : "auto";
        }

        private apply(mode: Mode) {
            const dark = mode === "dark" || (mode === "auto" && this.colorScheme.matches);
            document.documentElement.classList.toggle("dark", dark);
            if (this.toggle) this.toggle.textContent = this.labels[mode] ?? mode;
        }

        private onToggle = () => {
            const next = MODES[(MODES.indexOf(this.mode) + 1) % MODES.length];
            localStorage.setItem("theme-mode", next);
            this.apply(next);
        };

        private onColorSchemeChange = () => {
            if (this.mode === "auto") this.apply("auto");
        };

        connectedCallback() {
            this.apply(this.mode);
            this.toggle?.addEventListener("click", this.onToggle);
            this.colorScheme.addEventListener("change", this.onColorSchemeChange);
        }

        disconnectedCallback() {
            this.toggle?.removeEventListener("click", this.onToggle);
            this.colorScheme.removeEventListener("change", this.onColorSchemeChange);
        }
    }

    if (!customElements.get("blog-header")) {
        customElements.define("blog-header", BlogHeader);
    }
</script>
