---
import { tagHref, useTranslate } from "#/i18n";

interface Props {
    lang: string;
    tags: Array<{ name: string; count: number }>;
}

const { lang, tags } = Astro.props;
const t = useTranslate(lang);
---

<p class="tags tag-cloud">
    {
        tags.map(({ name, count }) => (
            <a class="tag" href={tagHref(lang, name)} title={t("tag_count", { count })}>
                #{name}
                <sup>{count}</sup>
            </a>
        ))
    }
</p>
