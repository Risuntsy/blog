---
import { t } from "#/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const [poweredBefore, poweredAfter] = t(lang, "footer_powered").split(
  "${astro}",
);
---

<footer class="footer">
  <div class="container">
    {t(lang, "site_title")}
    ·
    <a href="https://github.com/Risuntsy/blog" target="_blank" rel="noopener"
      >{t(lang, "footer_source")}</a
    >
    ·
    {poweredBefore}<a
      href="https://astro.build/"
      target="_blank"
      rel="noopener">Astro</a
    >{poweredAfter}
    · Neo-Pixl
  </div>
</footer>
