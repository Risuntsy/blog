---
import { useTranslate } from "#/i18n";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = useTranslate(lang);
const [poweredBefore, poweredAfter] = t("footer_powered").split("${astro}");
const [themeBefore, themeAfter] = t("footer_theme").split("${pixl}");
---

<footer class="footer">
    <span>{t("site_title")}</span>
    <span><a href="https://github.com/Risuntsy/blog" target="_blank" rel="noopener">{t("footer_source")}</a></span>
    <span>{poweredBefore}<a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>{poweredAfter}</span>
    <span
        >{themeBefore}<a href="https://github.com/Automattic/themes/tree/trunk/pixl" target="_blank" rel="noopener"
            >Pixl</a
        >{themeAfter}</span
    >
</footer>
