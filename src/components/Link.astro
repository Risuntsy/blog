---
import { l } from "#/i18n";

interface Props {
  lang: string;
  href?: string;
  class?: string;
  className?: string;
}

const { lang, href = "", class: className, className: classNameAlt } = Astro.props;
const to = l(lang, href || "/");
---

<a href={to} class={className || classNameAlt}><slot /></a>
