---
import { useTranslate } from "#/i18n";
import Header from "#/components/Header.astro";
import Footer from "#/components/Footer.astro";
import "@fontsource/dm-mono/latin-300.css";
import "@fontsource/dm-mono/latin-300-italic.css";
import "@fontsource/dm-mono/latin-500.css";
import "#/styles/global.css";

interface Props {
    lang: string;
    title?: string;
    description?: string;
    current?: string;
    languagePaths?: Record<string, string>;
}

const { lang, title, description, current = "", languagePaths } = Astro.props;
const t = useTranslate(lang);
const pageTitle = title ? `${title} | ${t("site_title")}` : t("site_title");
const desc = description || t("site_description");
---

<!doctype html>
<html lang={lang === "zh-cn" ? "zh-CN" : "en"}>
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={desc} />
        <link rel="alternate" type="application/rss+xml" title={t("site_title")} href={`/${lang}/rss.xml`} />
        <title>{pageTitle}</title>
        <script is:inline>
            (() => {
                const mode = localStorage.getItem("theme-mode") || "auto";

                const dark = mode === "dark" || (mode === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
                if (dark) document.documentElement.classList.add("dark");
            })();
        </script>
    </head>
    <body>
        <div class="container">
            <Header lang={lang} current={current} languagePaths={languagePaths} />
            <copy-region>
                <main>
                    <slot />
                </main>
            </copy-region>
        </div>
        <Footer lang={lang} />
        <script>
            class CopyRegion extends HTMLElement {
                private onActivate = (event: MouseEvent | KeyboardEvent) => {
                    const target = event.target;
                    if (!(target instanceof Element)) return;

                    const trigger = target.closest<HTMLElement>("[data-copy]");
                    if (!trigger || !this.contains(trigger)) return;
                    if (event instanceof KeyboardEvent && event.key !== "Enter" && event.key !== " ") return;

                    event.preventDefault();
                    void this.copy(trigger);
                };

                connectedCallback() {
                    this.addEventListener("click", this.onActivate);
                    this.addEventListener("keydown", this.onActivate);
                }

                disconnectedCallback() {
                    this.removeEventListener("click", this.onActivate);
                    this.removeEventListener("keydown", this.onActivate);
                }

                private timers = new WeakMap<HTMLElement, number>();

                private async copy(trigger: HTMLElement) {
                    const text =
                        trigger.dataset.copy === "inline"
                            ? (trigger.textContent ?? "")
                            : (trigger.closest(".code-window")?.querySelector("pre")?.textContent ?? "");

                    try {
                        await navigator.clipboard.writeText(text);
                    } catch {
                        return;
                    }

                    window.clearTimeout(this.timers.get(trigger));
                    const isButton = trigger.dataset.copy === "block";
                    const label = trigger.dataset.label ?? trigger.textContent ?? "";
                    if (isButton) {
                        trigger.dataset.label = label;
                        trigger.textContent = trigger.dataset.copied ?? label;
                    }
                    trigger.dataset.state = "copied";

                    this.timers.set(
                        trigger,
                        window.setTimeout(() => {
                            delete trigger.dataset.state;
                            if (isButton) trigger.textContent = label;
                        }, 1200),
                    );
                }
            }

            if (!customElements.get("copy-region")) {
                customElements.define("copy-region", CopyRegion);
            }
        </script>
    </body>
</html>
